{
  "metadata": {
    "title": "Candidate 5 Cycle Maps & Dynamic Orbit Analysis",
    "version": "1.0",
    "target_venue": "InCIS 2027",
    "specification_type": "Dynamical Systems Analysis (Pre-Implementation)"
  },
  "cycle_operator_definition": {
    "formula": "x_{k+1} = F_cycle(x_k) = (F_rest^{tau_r} o F_attack^{tau_a})(x_k)",
    "description": "Discrete-time mapping of state vector x_t from cycle start to post-rest cycle end"
  },
  "analytical_reset_conditions": {
    "condition_1_intra_burst_bounding": {
      "inequality": "SB_{tau_a} <= theta",
      "special_case_single_step": {
        "tau_a": 1,
        "energy_step_1": "beta * A_atk + (1 - beta) * E_0 = 0.40 * 0.4050 + 0.60 * 0.1656 = 0.2614",
        "comparison": "0.2614 < gamma (0.3350)",
        "accumulator_step_1": "max(0.0, 0.0 - 0.05) = 0.0000",
        "indicator_step_1": 0,
        "trust_step_1": "T_0 + alpha * (1 - T_0) = 1.0000",
        "consequence": "Single-step sub-threshold attack generates exactly zero penalty and zero evidence"
      }
    },
    "condition_2_accumulator_clearance": {
      "inequality": "tau_r >= ceil(SB_peak / delta)",
      "parameters": {
        "delta": 0.05
      },
      "examples": {
        "peak_sb_0_55": "ceil(0.55 / 0.05) = 11 steps",
        "peak_sb_1_10": "ceil(1.10 / 0.05) = 22 steps",
        "peak_sb_2_20": "ceil(2.20 / 0.05) = 44 steps"
      }
    },
    "condition_3_trust_restoration": {
      "formula": "tau_r >= ceil( (ln(1.0 - T_target) - ln(1.0 - T_post_attack)) / ln(1.0 - alpha) )",
      "parameters": {
        "alpha": 0.2057,
        "T_target": 0.80
      },
      "examples": {
        "recovery_from_0_60": "ceil( (ln(0.20) - ln(0.40)) / ln(0.7943) ) = 3 steps",
        "recovery_from_0_40": "ceil( (ln(0.20) - ln(0.60)) / ln(0.7943) ) = 5 steps"
      }
    }
  },
